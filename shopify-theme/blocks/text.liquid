<div class="blk blk-text"{% if block.settings.width != 'auto' %} data-w style="--w: {{ block.settings.width }}%"{% endif %} {{ block.shopify_attributes }}>
  <div class="rte tx tx--{{ block.settings.size }} txt-{{ block.settings.align }} col-{{ block.settings.color }}" style="max-width: {{ block.settings.max_width }}ch;{% if block.settings.align == 'center' %} margin-inline: auto;{% elsif block.settings.align == 'right' %} margin-left: auto;{% endif %}">
    {{ block.settings.text }}
  </div>
</div>

{% schema %}
{
  "name": "Text",
  "settings": [
    {"type": "richtext", "id": "text", "label": "Text", "default": "<p>Skriv din text här.</p>"},
    {"type": "select", "id": "size", "label": "Textstorlek", "default": "m", "options": [{"value": "s", "label": "Liten"}, {"value": "m", "label": "Normal"}, {"value": "l", "label": "Stor (ingress)"}]},
    {"type": "range", "id": "max_width", "label": "Största radlängd", "min": 30, "max": 140, "step": 5, "unit": "tkn", "default": 70},
    {"type": "select", "id": "align", "label": "Justering", "default": "left", "options": [{"value": "left", "label": "Vänster"}, {"value": "center", "label": "Mitten"}, {"value": "right", "label": "Höger"}]},
    {"type": "select", "id": "color", "label": "Färg", "default": "default", "options": [{"value": "default", "label": "Standard"}, {"value": "leather", "label": "Brun"}, {"value": "muted", "label": "Grå"}, {"value": "ivory", "label": "Vit (för mörk bakgrund)"}]},
    {"type": "select", "id": "width", "label": "Bredd", "default": "auto", "info": "Används när blocket ligger i en rad eller kolumn.", "options": [{"value": "auto", "label": "Automatisk"}, {"value": "25", "label": "25 %"}, {"value": "33", "label": "33 %"}, {"value": "40", "label": "40 %"}, {"value": "50", "label": "50 %"}, {"value": "60", "label": "60 %"}, {"value": "66", "label": "66 %"}, {"value": "75", "label": "75 %"}, {"value": "100", "label": "100 %"}]}
  ],
  "presets": [
    {"name": "Text"}
  ]
}
{% endschema %}
