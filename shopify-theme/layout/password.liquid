<!doctype html>
<html lang="sv" class="no-js">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ shop.name }}</title>
    <script>document.documentElement.classList.replace('no-js', 'js');</script>
    <style>
      @font-face { font-family: "Cormorant Garamond"; font-weight: 500; font-display: swap; src: url("{{ 'cormorant-500.woff2' | asset_url }}") format("woff2"); }
      @font-face { font-family: "Hanken Grotesk"; font-weight: 100 900; font-display: swap; src: url("{{ 'hanken-grotesk.woff2' | asset_url }}") format("woff2-variations"); }
    </style>
    {{ 'wolf.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body>
    <main id="MainContent">{{ content_for_layout }}</main>
  </body>
</html>
