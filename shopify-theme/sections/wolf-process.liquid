{% render 'section-style', s: section.settings, id: section.id %}
<section class="section wolf-sec{% if section.settings.background == 'bone' %} bg-bone border-y{% endif %}" aria-labelledby="H-{{ section.id }}">
  <div class="page-width"{% if section.settings.anchor != blank %} id="{{ section.settings.anchor | handleize }}"{% endif %}>
      <div class="max-2xl" data-reveal>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 id="H-{{ section.id }}" class="mt-2">{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.text != blank -%}<div class="lede mt-3 rte">{{ section.settings.text }}</div>{%- endif -%}
      </div>
    <ol class="steps{% if section.settings.step_background == 'bone' %} steps--bone{% endif %}">
      {%- for block in section.blocks -%}
        <li {{ block.shopify_attributes }} data-reveal style="--d: {{ forloop.index0 | times: 110 }}ms">
          <span class="num" aria-hidden="true">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>
          <h3><span class="visually-hidden">Steg {{ forloop.index }}: </span>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </li>
      {%- endfor -%}
    </ol>
    {%- if section.settings.button_label != blank or section.settings.note != blank -%}
      <div class="after-steps" data-reveal>
        {%- if section.settings.button_label != blank -%}<a href="{{ section.settings.button_link }}" class="btn btn--primary">{{ section.settings.button_label }}{% render 'icon', name: 'arrow' %}</a>{%- endif -%}
        {%- if section.settings.note != blank -%}<p class="small muted max-xl">{{ section.settings.note }}</p>{%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Process i steg",
  "tag": "div",
  "max_blocks": 4,
  "settings": [
    {"type": "text", "id": "eyebrow", "label": "Överrubrik", "default": "Specialbeställningar"},
    {"type": "text", "id": "heading", "label": "Rubrik", "default": "Så går en förfrågan till"},
    {"type": "richtext", "id": "text", "label": "Ingress", "default": "<p>Varje uppdrag är olika. Vi börjar alltid med att förstå vad väskan ska klara av.</p>"},
    {"type": "text", "id": "button_label", "label": "Knapptext", "default": "Skicka en förfrågan"},
    {"type": "url", "id": "button_link", "label": "Knapplänk"},
    {"type": "textarea", "id": "note", "label": "Kommentar bredvid knappen", "default": "Vilka lösningar som är möjliga beror på produkt, specifikation och antal – det går vi igenom tillsammans."},
    {"type": "select", "id": "background", "label": "Bakgrund", "default": "bone", "options": [{"value": "ivory", "label": "Varmvit"}, {"value": "bone", "label": "Benvit"}]},
    {"type": "text", "id": "anchor", "label": "Ankare (för länkar som #sa-gar-det-till)", "default": "sa-gar-det-till"},
    {"type": "select", "id": "step_background", "label": "Stegens bakgrund", "default": "ivory", "options": [{"value": "ivory", "label": "Varmvit"}, {"value": "bone", "label": "Benvit"}]},
    {"type": "header", "content": "Layout"},
    {"type": "select", "id": "spacing_top", "label": "Avstånd ovanför", "options": [{"value": "default", "label": "Standard"}, {"value": "none", "label": "Inget"}, {"value": "s", "label": "Litet"}, {"value": "m", "label": "Mellan"}, {"value": "l", "label": "Stort"}, {"value": "xl", "label": "Extra stort"}], "default": "default"},
    {"type": "select", "id": "spacing_bottom", "label": "Avstånd under", "options": [{"value": "default", "label": "Standard"}, {"value": "none", "label": "Inget"}, {"value": "s", "label": "Litet"}, {"value": "m", "label": "Mellan"}, {"value": "l", "label": "Stort"}, {"value": "xl", "label": "Extra stort"}], "default": "default"},
    {"type": "select", "id": "bg", "label": "Bakgrundsfärg", "default": "default", "options": [{"value": "default", "label": "Standard"}, {"value": "ivory", "label": "Varmvit"}, {"value": "bone", "label": "Benvit"}, {"value": "sand", "label": "Sand"}, {"value": "navy", "label": "Mörkblå"}]},
    {"type": "select", "id": "content_width", "label": "Innehållets bredd", "default": "default", "options": [{"value": "default", "label": "Standard"}, {"value": "narrow", "label": "Smal"}, {"value": "wide", "label": "Bred"}, {"value": "full", "label": "Hela skärmen"}]},
    {"type": "select", "id": "heading_size", "label": "Rubrikstorlek", "default": "default", "options": [{"value": "default", "label": "Standard"}, {"value": "s", "label": "Liten"}, {"value": "m", "label": "Mellan"}, {"value": "l", "label": "Stor"}, {"value": "xl", "label": "Extra stor"}]},
    {"type": "checkbox", "id": "hide_mobile", "label": "Dölj på mobil", "default": false},
    {"type": "checkbox", "id": "hide_desktop", "label": "Dölj på dator", "default": false}
  ],
  "blocks": [
    {"type": "step", "name": "Steg", "settings": [{"type": "text", "id": "title", "label": "Rubrik", "default": "Steg"}, {"type": "textarea", "id": "text", "label": "Text"}]}
  ],
  "presets": [
    {"name": "Process i steg", "blocks": [{"type": "step", "settings": {"title": "Berätta om era behov", "text": "Beskriv vad väskan ska innehålla, hur den ska användas och vilka önskemål ni har om exempelvis storlek, material och antal."}}, {"type": "step", "settings": {"title": "Vi diskuterar lösningen", "text": "Vi går igenom era krav tillsammans för att förstå behovet och bedöma vilka utföranden som är rimliga."}}, {"type": "step", "settings": {"title": "En lösning utifrån era krav", "text": "Vi undersöker möjligheterna tillsammans med våra underleverantörer utifrån den önskade produkten och specifikationen."}}]}
  ]
}
{% endschema %}
