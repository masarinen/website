{% render 'section-style', s: section.settings, id: section.id %}
<section class="section wolf-sec bg-navy on-dark cta" aria-labelledby="H-{{ section.id }}">
  {%- if section.settings.show_art -%}<div class="cta__art">{% render 'illustration', name: 'hardcase', stroke: 0.9 %}</div>{%- endif -%}
  <div class="page-width">
    <div class="cta__inner" data-reveal>
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 id="H-{{ section.id }}">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
      <div class="cta__actions">
        {%- if section.settings.button_label != blank -%}<a href="{{ section.settings.button_link }}" class="btn btn--light">{{ section.settings.button_label }}{% render 'icon', name: 'arrow' %}</a>{%- endif -%}
        {%- if section.settings.show_contact -%}
          {%- if settings.phone != blank -%}<a class="cta__contact" href="tel:{{ settings.phone_link }}">{% render 'icon', name: 'phone' %}<span class="link-underline">{{ settings.phone }}</span></a>{%- endif -%}
          {%- if settings.email != blank -%}<a class="cta__contact" href="mailto:{{ settings.email }}">{% render 'icon', name: 'mail' %}<span class="link-underline">{{ settings.email }}</span></a>{%- endif -%}
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Kontakt-uppmaning",
  "tag": "div",
  "settings": [
    {"type": "text", "id": "eyebrow", "label": "Överrubrik", "default": "Förfrågningar"},
    {"type": "text", "id": "heading", "label": "Rubrik", "default": "Har ni ett projekt i åtanke?"},
    {"type": "textarea", "id": "text", "label": "Text", "default": "Berätta om vad som ska förvaras, bäras eller presenteras. Kontakta oss så diskuterar vi väskor och etuier anpassade efter era behov."},
    {"type": "text", "id": "button_label", "label": "Knapptext", "default": "Kontakta oss"},
    {"type": "url", "id": "button_link", "label": "Knapplänk"},
    {"type": "checkbox", "id": "show_contact", "label": "Visa telefon och e-post", "default": true},
    {"type": "checkbox", "id": "show_art", "label": "Visa illustration i bakgrunden", "default": true},
    {"type": "header", "content": "Layout"},
    {"type": "select", "id": "spacing_top", "label": "Avstånd ovanför", "options": [{"value": "default", "label": "Standard"}, {"value": "none", "label": "Inget"}, {"value": "s", "label": "Litet"}, {"value": "m", "label": "Mellan"}, {"value": "l", "label": "Stort"}, {"value": "xl", "label": "Extra stort"}], "default": "default"},
    {"type": "select", "id": "spacing_bottom", "label": "Avstånd under", "options": [{"value": "default", "label": "Standard"}, {"value": "none", "label": "Inget"}, {"value": "s", "label": "Litet"}, {"value": "m", "label": "Mellan"}, {"value": "l", "label": "Stort"}, {"value": "xl", "label": "Extra stort"}], "default": "default"},
    {"type": "select", "id": "bg", "label": "Bakgrundsfärg", "default": "default", "options": [{"value": "default", "label": "Standard"}, {"value": "ivory", "label": "Varmvit"}, {"value": "bone", "label": "Benvit"}, {"value": "sand", "label": "Sand"}, {"value": "navy", "label": "Mörkblå"}]},
    {"type": "select", "id": "content_width", "label": "Innehållets bredd", "default": "default", "options": [{"value": "default", "label": "Standard"}, {"value": "narrow", "label": "Smal"}, {"value": "wide", "label": "Bred"}, {"value": "full", "label": "Hela skärmen"}]},
    {"type": "select", "id": "heading_size", "label": "Rubrikstorlek", "default": "default", "options": [{"value": "default", "label": "Standard"}, {"value": "s", "label": "Liten"}, {"value": "m", "label": "Mellan"}, {"value": "l", "label": "Stor"}, {"value": "xl", "label": "Extra stor"}]},
    {"type": "checkbox", "id": "hide_mobile", "label": "Dölj på mobil", "default": false},
    {"type": "checkbox", "id": "hide_desktop", "label": "Dölj på dator", "default": false}
  ],
  "presets": [
    {"name": "Kontakt-uppmaning"}
  ]
}
{% endschema %}
