{% render 'section-style', s: section.settings, id: section.id %}
<section class="section wolf-sec{% if section.settings.background == 'bone' %} bg-bone border-y{% endif %}" aria-labelledby="H-{{ section.id }}">
  <div class="page-width">
      <div class="max-2xl" data-reveal>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 id="H-{{ section.id }}" class="mt-2">{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.text != blank -%}<div class="lede mt-3 rte">{{ section.settings.text }}</div>{%- endif -%}
      </div>
    <ul class="usecases">
      {%- for block in section.blocks -%}
        <li {{ block.shopify_attributes }} data-reveal style="--d: {{ forloop.index0 | modulo: 2 | times: 100 }}ms">
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 300 | image_tag: loading: 'lazy' }}
          {%- elsif block.settings.illustration != 'none' -%}
            {% render 'illustration', name: block.settings.illustration %}
          {%- endif -%}
          <div><h3>{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p></div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Användningsområden",
  "tag": "div",
  "max_blocks": 8,
  "settings": [
    {"type": "text", "id": "eyebrow", "label": "Överrubrik", "default": "Användningsområden"},
    {"type": "text", "id": "heading", "label": "Rubrik", "default": "Väskor för nästan allt som går att bära"},
    {"type": "richtext", "id": "text", "label": "Ingress", "default": "<p>Några exempel på vad vi tar fram. Har ni ett behov som inte syns här är ni välkomna att fråga.</p>"},
    {"type": "select", "id": "background", "label": "Bakgrund", "default": "bone", "options": [{"value": "ivory", "label": "Varmvit"}, {"value": "bone", "label": "Benvit"}]},
    {"type": "header", "content": "Layout"},
    {"type": "select", "id": "spacing_top", "label": "Avstånd ovanför", "options": [{"value": "default", "label": "Standard"}, {"value": "none", "label": "Inget"}, {"value": "s", "label": "Litet"}, {"value": "m", "label": "Mellan"}, {"value": "l", "label": "Stort"}, {"value": "xl", "label": "Extra stort"}], "default": "default"},
    {"type": "select", "id": "spacing_bottom", "label": "Avstånd under", "options": [{"value": "default", "label": "Standard"}, {"value": "none", "label": "Inget"}, {"value": "s", "label": "Litet"}, {"value": "m", "label": "Mellan"}, {"value": "l", "label": "Stort"}, {"value": "xl", "label": "Extra stort"}], "default": "default"},
    {"type": "select", "id": "bg", "label": "Bakgrundsfärg", "default": "default", "options": [{"value": "default", "label": "Standard"}, {"value": "ivory", "label": "Varmvit"}, {"value": "bone", "label": "Benvit"}, {"value": "sand", "label": "Sand"}, {"value": "navy", "label": "Mörkblå"}]},
    {"type": "select", "id": "content_width", "label": "Innehållets bredd", "default": "default", "options": [{"value": "default", "label": "Standard"}, {"value": "narrow", "label": "Smal"}, {"value": "wide", "label": "Bred"}, {"value": "full", "label": "Hela skärmen"}]},
    {"type": "select", "id": "heading_size", "label": "Rubrikstorlek", "default": "default", "options": [{"value": "default", "label": "Standard"}, {"value": "s", "label": "Liten"}, {"value": "m", "label": "Mellan"}, {"value": "l", "label": "Stor"}, {"value": "xl", "label": "Extra stor"}]},
    {"type": "checkbox", "id": "hide_mobile", "label": "Dölj på mobil", "default": false},
    {"type": "checkbox", "id": "hide_desktop", "label": "Dölj på dator", "default": false}
  ],
  "blocks": [
    {"type": "item", "name": "Område", "settings": [{"type": "image_picker", "id": "image", "label": "Bild"}, {"type": "select", "id": "illustration", "label": "Illustration (visas om ingen bild valts)", "options": [{"value": "hardcase", "label": "Hård väska med inredning"}, {"value": "demo", "label": "Demoväska"}, {"value": "suitcase", "label": "Resväska"}, {"value": "wine", "label": "Vinresväska"}, {"value": "toolcase", "label": "Serviceväska"}, {"value": "winder", "label": "Watch winder"}, {"value": "jewelry", "label": "Smyckeskrin"}, {"value": "briefcase", "label": "Portfölj"}, {"value": "trolley", "label": "Shoppingvagn"}, {"value": "none", "label": "Ingen"}], "default": "demo"}, {"type": "text", "id": "title", "label": "Rubrik", "default": "Rubrik"}, {"type": "textarea", "id": "text", "label": "Text"}]}
  ],
  "presets": [
    {"name": "Användningsområden", "blocks": [{"type": "item", "settings": {"illustration": "demo", "title": "Demo- och säljväskor", "text": "Kollektions- och demoväskor som låter säljare visa sina produkter på ett ordnat och representativt sätt – från dammsugare till klockor och knivar."}}, {"type": "item", "settings": {"illustration": "hardcase", "title": "Skyddande väskor", "text": "Vattentäta och stöttåliga väskor för känslig utrustning som ska transporteras säkert."}}, {"type": "item", "settings": {"illustration": "jewelry", "title": "Etuier och skrin", "text": "Etuier som presenterar och skyddar, i en tradition som sträcker sig tillbaka till familjens första verkstad."}}, {"type": "item", "settings": {"illustration": "toolcase", "title": "Service- och verktygsväskor", "text": "Väskor för tekniker och servicepersonal, där verktyg och reservdelar har sin givna plats."}}]}
  ]
}
{% endschema %}
