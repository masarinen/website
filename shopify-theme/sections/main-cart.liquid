<section class="section--tight">
  <div class="page-width">
    <h1>Varukorg</h1>
    {%- if cart.item_count > 0 -%}
      <form action="{{ routes.cart_url }}" method="post" id="CartForm">
        <table class="cart-table">
          <caption class="visually-hidden">Varor i varukorgen</caption>
          <thead><tr><th scope="col">Produkt</th><th scope="col">Antal</th><th scope="col" style="text-align: right">Summa</th></tr></thead>
          <tbody>
            {%- for item in cart.items -%}
              <tr>
                <td>
                  <div class="cart-item">
                    <div class="cart-item__img">
                      {%- if item.image -%}{{ item.image | image_url: width: 200 | image_tag: loading: 'lazy', alt: item.title }}{%- endif -%}
                    </div>
                    <div>
                      <a class="cart-item__title" href="{{ item.url }}">{{ item.product.title }}</a>
                      {%- unless item.product.has_only_default_variant -%}<p class="small muted">{{ item.variant.title }}</p>{%- endunless -%}
                      <p class="small">{{ item.final_price | money }}</p>
                      <a class="cart-remove" href="{{ item.url_to_remove }}">Ta bort<span class="visually-hidden"> {{ item.product.title }}</span></a>
                    </div>
                  </div>
                </td>
                <td>
                  <label class="visually-hidden" for="Qty-{{ forloop.index }}">Antal för {{ item.product.title }}</label>
                  <div class="qty">
                    <button type="button" data-qty="-1" aria-label="Minska antal">−</button>
                    <input id="Qty-{{ forloop.index }}" type="number" name="updates[]" value="{{ item.quantity }}" min="0" inputmode="numeric">
                    <button type="button" data-qty="1" aria-label="Öka antal">+</button>
                  </div>
                </td>
                <td style="text-align: right">{{ item.final_line_price | money }}</td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>

        <div class="cart-summary">
          <p class="cart-summary__total"><span>Delsumma</span><span>{{ cart.total_price | money_with_currency }}</span></p>
          <p class="small muted">{% if cart.taxes_included %}Inklusive moms. {% endif %}Frakt beräknas i kassan.</p>
          {%- if section.settings.show_note -%}
            <div class="field">
              <label for="CartNote">Meddelande till oss</label>
              <textarea id="CartNote" name="note" rows="3">{{ cart.note }}</textarea>
            </div>
          {%- endif -%}
          <button type="submit" name="update" class="btn btn--secondary">Uppdatera varukorgen</button>
          <button type="submit" name="checkout" class="btn btn--primary">Till kassan {% render 'icon', name: 'arrow' %}</button>
        </div>
      </form>
    {%- else -%}
      <div class="empty-state mt-5">
        <p>Varukorgen är tom.</p>
        <p class="mt-3"><a class="btn btn--primary" href="{{ routes.all_products_collection_url }}">Fortsätt handla {% render 'icon', name: 'arrow' %}</a></p>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Varukorg",
  "tag": "div",
  "settings": [
    { "type": "checkbox", "id": "show_note", "label": "Visa fält för meddelande", "default": true }
  ]
}
{% endschema %}
