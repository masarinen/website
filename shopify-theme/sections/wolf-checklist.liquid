<section class="section--tight" aria-labelledby="H-{{ section.id }}">
  <div class="page-width grid-12 border-t" style="padding-top: 3.5rem">
    <div class="col-5" data-reveal>
      <h2 id="H-{{ section.id }}" class="h3" style="font-size: 2rem">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<div class="muted mt-2 rte">{{ section.settings.text }}</div>{%- endif -%}
      {%- if section.settings.button_label != blank -%}<p class="mt-4"><a href="{{ section.settings.button_link }}" class="btn btn--primary">{{ section.settings.button_label }}{% render 'icon', name: 'arrow' %}</a></p>{%- endif -%}
    </div>
    <ul class="checklist col-6 start-7" data-reveal>
      {%- for block in section.blocks -%}
        <li {{ block.shopify_attributes }}>{% render 'icon', name: 'check' %}<span>{{ block.settings.text }}</span></li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Checklista",
  "tag": "div",
  "max_blocks": 10,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Rubrik",
      "default": "Inför er förfrågan"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Ju mer vi vet från början, desto lättare blir det att bedöma vad som passar. Det här är bra att berätta:</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Knapptext",
      "default": "Skicka en förfrågan"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Knapplänk"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Punkt",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Punkt"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Checklista",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "text": "Vad ska väskan eller etuiet innehålla – gärna med mått och vikt"
          }
        },
        {
          "type": "item",
          "settings": {
            "text": "Hur och var ska den användas, och hur ofta transporteras den"
          }
        },
        {
          "type": "item",
          "settings": {
            "text": "Mjukt eller hårt utförande, och eventuella krav på skydd"
          }
        },
        {
          "type": "item",
          "settings": {
            "text": "Önskad inredning, färg, märkning eller logotyp"
          }
        },
        {
          "type": "item",
          "settings": {
            "text": "Ungefärligt antal och när ni behöver väskorna"
          }
        }
      ]
    }
  ]
}
{% endschema %}
