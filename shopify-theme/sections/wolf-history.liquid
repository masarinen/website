{% render 'section-style', s: section.settings, id: section.id %}
<section class="section wolf-sec bg-bone border-y" aria-labelledby="H-{{ section.id }}">
  <div class="page-width grid-12">
    <div class="col-5">
      <div data-reveal>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 id="H-{{ section.id }}" class="mt-2">{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.text != blank -%}<div class="lede mt-3 rte" data-reveal style="--d: 80ms">{{ section.settings.text }}</div>{%- endif -%}
      {%- if section.settings.link_label != blank -%}
        <p class="mt-4" data-reveal style="--d: 140ms"><a class="arrow-link" href="{{ section.settings.link }}"><span class="link-underline">{{ section.settings.link_label }}</span>{% render 'icon', name: 'arrow' %}</a></p>
      {%- endif -%}
    </div>
    <ol class="milestones-grid col-6 start-7">
      {%- for block in section.blocks -%}
        <li {{ block.shopify_attributes }} data-reveal style="--d: {{ forloop.index0 | times: 90 }}ms">
          <p class="year">{{ block.settings.year }}</p>
          <p class="title">{{ block.settings.title }}</p>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% schema %}
{
  "name": "Historik (kort)",
  "tag": "div",
  "max_blocks": 6,
  "settings": [
    {"type": "text", "id": "eyebrow", "label": "Överrubrik", "default": "Ett familjeföretag"},
    {"type": "text", "id": "heading", "label": "Rubrik", "default": "Hantverk som gått i arv i över 180 år"},
    {"type": "richtext", "id": "text", "label": "Text", "default": "<p>Familjen Wolf har över 180 års erfarenhet av att tillverka etuier, skrin och väskor. Kunnandet har gått i arv från generation till generation – från en silversmedja i Tyskland till dagens verksamhet i Stockholmsområdet.</p>"},
    {"type": "text", "id": "link_label", "label": "Länktext", "default": "Läs om familjen Wolf"},
    {"type": "url", "id": "link", "label": "Länk"},
    {"type": "header", "content": "Layout"},
    {"type": "select", "id": "spacing_top", "label": "Avstånd ovanför", "options": [{"value": "default", "label": "Standard"}, {"value": "none", "label": "Inget"}, {"value": "s", "label": "Litet"}, {"value": "m", "label": "Mellan"}, {"value": "l", "label": "Stort"}, {"value": "xl", "label": "Extra stort"}], "default": "default"},
    {"type": "select", "id": "spacing_bottom", "label": "Avstånd under", "options": [{"value": "default", "label": "Standard"}, {"value": "none", "label": "Inget"}, {"value": "s", "label": "Litet"}, {"value": "m", "label": "Mellan"}, {"value": "l", "label": "Stort"}, {"value": "xl", "label": "Extra stort"}], "default": "default"},
    {"type": "select", "id": "bg", "label": "Bakgrundsfärg", "default": "default", "options": [{"value": "default", "label": "Standard"}, {"value": "ivory", "label": "Varmvit"}, {"value": "bone", "label": "Benvit"}, {"value": "sand", "label": "Sand"}, {"value": "navy", "label": "Mörkblå"}]},
    {"type": "select", "id": "content_width", "label": "Innehållets bredd", "default": "default", "options": [{"value": "default", "label": "Standard"}, {"value": "narrow", "label": "Smal"}, {"value": "wide", "label": "Bred"}, {"value": "full", "label": "Hela skärmen"}]},
    {"type": "select", "id": "heading_size", "label": "Rubrikstorlek", "default": "default", "options": [{"value": "default", "label": "Standard"}, {"value": "s", "label": "Liten"}, {"value": "m", "label": "Mellan"}, {"value": "l", "label": "Stor"}, {"value": "xl", "label": "Extra stor"}]},
    {"type": "checkbox", "id": "hide_mobile", "label": "Dölj på mobil", "default": false},
    {"type": "checkbox", "id": "hide_desktop", "label": "Dölj på dator", "default": false}
  ],
  "blocks": [
    {"type": "milestone", "name": "Årtal", "settings": [{"type": "text", "id": "year", "label": "Årtal", "default": "1936"}, {"type": "text", "id": "title", "label": "Händelse", "default": "Händelse"}]}
  ],
  "presets": [
    {"name": "Historik (kort)", "blocks": [{"type": "milestone", "settings": {"year": "1896", "title": "Skandinaviska Etuifabriken i Malmö"}}, {"type": "milestone", "settings": {"year": "1936", "title": "Stockholms Etui- och koffertfabrik AB"}}, {"type": "milestone", "settings": {"year": "1977", "title": "Nästa generation tar över"}}, {"type": "milestone", "settings": {"year": "1986", "title": "Butiken på Atlasgatan"}}]}
  ]
}
{% endschema %}
