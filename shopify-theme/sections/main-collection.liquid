{%- comment -%}
  Kollektionssida – en egen sida per produktgrupp eller märke (t.ex. Wolf1834,
  Vinväskor, Watch winders). Rubrik, presentation och bild hämtas från
  kollektionen i Shopify (Produkter → Kollektioner).
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign sort_by = collection.sort_by | default: collection.default_sort_by
  assign active_count = 0
  for filter in collection.filters
    assign active_count = active_count | plus: filter.active_values.size
    if filter.type == 'price_range'
      if filter.min_value.value != nil or filter.max_value.value != nil
        assign active_count = active_count | plus: 1
      endif
    endif
  endfor
  assign quick_filter = nil
  if s.quick_filter != 'none'
    for filter in collection.filters
      if filter.param_name == s.quick_filter
        assign quick_filter = filter
      endif
    endfor
  endif
-%}
{% render 'section-style', s: s, id: section.id %}

{%- paginate collection.products by s.per_page -%}
<section class="section--tight wolf-sec coll" aria-labelledby="CollTitle-{{ section.id }}">
  <div class="page-width">
    <nav class="coll__crumbs small muted" aria-label="Brödsmulor">
      <a href="{{ routes.root_url }}" class="link-underline">Startsida</a>
      <span aria-hidden="true">/</span>
      <a href="{{ s.parent_link | default: routes.collections_url }}" class="link-underline">{{ s.parent_label }}</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{{ collection.title }}</span>
    </nav>

    <header class="coll__head{% if s.show_image and collection.image %} coll__head--image{% endif %}">
      <div class="coll__intro">
        {%- if s.eyebrow != blank -%}<p class="eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
        <h1 id="CollTitle-{{ section.id }}" class="coll__title mt-2">
          {%- if s.title_image != blank -%}
            {%- assign logo_style = 'display: block; height: auto; max-width: 100%; width: ' | append: s.title_image_width | append: 'px' -%}
            {{ s.title_image | image_url: width: 1200 | image_tag: alt: collection.title, loading: 'eager', widths: '300, 600, 900, 1200', style: logo_style }}
          {%- else -%}
            {{ collection.title }}
          {%- endif -%}
        </h1>
        {%- if s.show_description and collection.description != blank -%}
          <div class="coll__desc rte lede mt-3" data-collapsible>
            <div class="coll__desc-inner">{{ collection.description }}</div>
          </div>
          <button type="button" class="coll__more" data-collapsible-toggle hidden aria-expanded="false">Läs mer</button>
        {%- endif -%}
      </div>
      {%- if s.show_image and collection.image -%}
        <div class="coll__image">
          {{ collection.image | image_url: width: 1400 | image_tag: loading: 'eager', widths: '500, 800, 1100, 1400', sizes: '(min-width: 1024px) 40vw, 100vw', alt: collection.image.alt | default: collection.title }}
        </div>
      {%- endif -%}
    </header>

    {%- if quick_filter and quick_filter.values.size > 1 -%}
      <nav class="coll__chips" aria-label="{{ quick_filter.label | escape }}">
        <a class="chip{% if quick_filter.active_values.size == 0 %} is-active{% endif %}" href="{{ quick_filter.url_to_remove }}"{% if quick_filter.active_values.size == 0 %} aria-current="true"{% endif %}>Alla</a>
        {%- for value in quick_filter.values -%}
          {%- if value.count > 0 or value.active -%}
            <a class="chip{% if value.active %} is-active{% endif %}" href="{% if value.active %}{{ value.url_to_remove }}{% else %}{{ value.url_to_add }}{% endif %}"{% if value.active %} aria-current="true"{% endif %}>{{ value.label }}</a>
          {%- endif -%}
        {%- endfor -%}
      </nav>
    {%- endif -%}

    <form class="coll__toolbar" action="{{ collection.url }}" method="get" id="CollForm-{{ section.id }}" data-auto-submit>
      <p class="coll__count small muted" role="status">
        {{ collection.products_count }} {% if collection.products_count == 1 %}produkt{% else %}produkter{% endif %}
      </p>

      <div class="coll__controls">
        {%- if s.show_filters and collection.filters.size > 0 -%}
          <details class="coll__filters">
            <summary class="coll__btn">
              Filtrera{% if active_count > 0 %} <span class="coll__badge">{{ active_count }}</span>{% endif %}
            </summary>
            <div class="coll__panel">
              {%- for filter in collection.filters -%}
                {%- case filter.type -%}
                  {%- when 'list', 'boolean' -%}
                    <fieldset class="coll__group">
                      <legend>{{ filter.label }}</legend>
                      {%- for value in filter.values -%}
                        <label class="coll__check{% if value.count == 0 and value.active == false %} is-disabled{% endif %}">
                          <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}"{% if value.active %} checked{% endif %}{% if value.count == 0 and value.active == false %} disabled{% endif %}>
                          <span>{{ value.label }}</span> <span class="muted">({{ value.count }})</span>
                        </label>
                      {%- endfor -%}
                    </fieldset>
                  {%- when 'price_range' -%}
                    <fieldset class="coll__group">
                      <legend>{{ filter.label }}</legend>
                      <div class="coll__price">
                        <label><span class="visually-hidden">Lägsta pris</span>
                          <input type="number" inputmode="numeric" min="0" name="{{ filter.min_value.param_name }}" placeholder="Från" value="{% if filter.min_value.value %}{{ filter.min_value.value | divided_by: 100 }}{% endif %}">
                        </label>
                        <span aria-hidden="true">–</span>
                        <label><span class="visually-hidden">Högsta pris</span>
                          <input type="number" inputmode="numeric" min="0" name="{{ filter.max_value.param_name }}" placeholder="{{ filter.range_max | divided_by: 100 }}" value="{% if filter.max_value.value %}{{ filter.max_value.value | divided_by: 100 }}{% endif %}">
                        </label>
                        <span class="small muted">kr</span>
                      </div>
                    </fieldset>
                {%- endcase -%}
              {%- endfor -%}
              <div class="coll__panel-actions">
                <button type="submit" class="btn btn--primary">Visa produkter</button>
                {%- if active_count > 0 -%}<a class="arrow-link" href="{{ collection.url }}?sort_by={{ sort_by }}"><span class="link-underline">Rensa filter</span></a>{%- endif -%}
              </div>
            </div>
          </details>
        {%- endif -%}

        {%- if s.show_sort -%}
          <label class="coll__sort">
            <span class="small muted">Sortera</span>
            <select name="sort_by" data-submit-on-change>
              {%- for option in collection.sort_options -%}
                <option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name }}</option>
              {%- endfor -%}
            </select>
          </label>
          <noscript><button type="submit" class="btn btn--secondary">Sortera</button></noscript>
        {%- endif -%}
      </div>
    </form>

    {%- if active_count > 0 -%}
      <ul class="coll__active" aria-label="Aktiva filter">
        {%- for filter in collection.filters -%}
          {%- for value in filter.active_values -%}
            <li><a class="chip is-active" href="{{ value.url_to_remove }}">{{ value.label }} <span aria-hidden="true">×</span><span class="visually-hidden">(ta bort filter)</span></a></li>
          {%- endfor -%}
          {%- if filter.type == 'price_range' -%}
            {%- if filter.min_value.value != nil or filter.max_value.value != nil -%}
              <li><a class="chip is-active" href="{{ filter.url_to_remove }}">
                {{ filter.min_value.value | default: 0 | money_without_trailing_zeros }} – {{ filter.max_value.value | default: filter.range_max | money_without_trailing_zeros }}
                <span aria-hidden="true">×</span><span class="visually-hidden">(ta bort prisfilter)</span></a></li>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if collection.products.size > 0 -%}
      <ul class="products products--{{ s.columns }}">
        {%- for product in collection.products -%}
          <li>{% render 'product-card', product: product %}</li>
        {%- endfor -%}
      </ul>
      {%- if paginate.pages > 1 -%}
        <nav class="pagination" aria-label="Sidnumrering">
          {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" aria-label="Föregående sida">‹</a>{%- endif -%}
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>
            {%- elsif part.title == paginate.current_page -%}<span class="current" aria-current="page">{{ part.title }}</span>
            {%- else -%}<span>{{ part.title }}</span>{%- endif -%}
          {%- endfor -%}
          {%- if paginate.next -%}<a href="{{ paginate.next.url }}" aria-label="Nästa sida">›</a>{%- endif -%}
        </nav>
      {%- endif -%}
    {%- else -%}
      <div class="empty-state mt-5">
        {%- if active_count > 0 -%}
          <p>Inga produkter matchar dina filter.</p>
          <p class="mt-2"><a class="arrow-link" href="{{ collection.url }}"><span class="link-underline">Rensa filter</span>{% render 'icon', name: 'arrow' %}</a></p>
        {%- else -%}
          <p>Det finns inga produkter i den här kategorin just nu.</p>
          <p class="mt-2"><a class="arrow-link" href="/pages/sortiment"><span class="link-underline">Se hela sortimentet</span>{% render 'icon', name: 'arrow' %}</a></p>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>
{%- endpaginate -%}

<script>
  (function () {
    var root = document.getElementById('CollForm-{{ section.id }}');
    if (!root) return;
    root.querySelectorAll('[data-submit-on-change]').forEach(function (el) {
      el.addEventListener('change', function () { root.submit(); });
    });
    var desc = document.querySelector('[data-collapsible]');
    var more = document.querySelector('[data-collapsible-toggle]');
    if (desc && more && desc.scrollHeight > desc.clientHeight + 8) {
      more.hidden = false;
      more.addEventListener('click', function () {
        var open = desc.classList.toggle('is-open');
        more.setAttribute('aria-expanded', String(open));
        more.textContent = open ? 'Visa mindre' : 'Läs mer';
      });
    } else if (desc) {
      desc.classList.add('is-open');
    }
  })();
</script>

{% schema %}
{
  "name": "Kollektion",
  "tag": "div",
  "settings": [
    { "type": "paragraph", "content": "Rubrik, presentationstext och bild hämtas från kollektionen under Produkter → Kollektioner. Varje kollektion (t.ex. Wolf1834, Vinväskor, Watch winders) får automatiskt en egen sida med den här layouten." },
    { "type": "text", "id": "eyebrow", "label": "Överrubrik", "default": "Webbutik" },
    { "type": "text", "id": "parent_label", "label": "Namn i brödsmulan", "default": "Sortiment" },
    { "type": "url", "id": "parent_link", "label": "Länk i brödsmulan", "info": "T.ex. sidan Sortiment. Tom = sidan med alla produktserier." },
    { "type": "image_picker", "id": "title_image", "label": "Logotyp i stället för rubrik", "info": "T.ex. märkets logotyp. Produktseriens namn används då som beskrivning för sökmotorer och skärmläsare." },
    { "type": "range", "id": "title_image_width", "label": "Logotypens bredd", "min": 120, "max": 600, "step": 10, "unit": "px", "default": 300 },
    { "type": "checkbox", "id": "show_description", "label": "Visa kollektionens beskrivning", "default": true },
    { "type": "checkbox", "id": "show_image", "label": "Visa kollektionens bild", "default": true },
    { "type": "header", "content": "Snabbval, filter och sortering" },
    { "type": "select", "id": "quick_filter", "label": "Snabbval under rubriken", "default": "filter.p.product_type", "info": "Visar knappar som Klocklådor, Watch winders, Smyckeskrin. Kräver att filtret är aktiverat i appen Search & Discovery.", "options": [
      { "value": "none", "label": "Inga" },
      { "value": "filter.p.product_type", "label": "Produkttyp" },
      { "value": "filter.p.vendor", "label": "Märke" }
    ] },
    { "type": "checkbox", "id": "show_filters", "label": "Visa filter", "default": true },
    { "type": "checkbox", "id": "show_sort", "label": "Visa sortering", "default": true },
    { "type": "header", "content": "Produkter" },
    { "type": "range", "id": "per_page", "label": "Produkter per sida", "min": 8, "max": 48, "step": 4, "default": 24 },
    { "type": "select", "id": "columns", "label": "Kolumner (dator)", "default": "4", "options": [
      { "value": "3", "label": "3" }, { "value": "4", "label": "4" }
    ] },
    { "type": "header", "content": "Layout" },
    { "type": "select", "id": "spacing_top", "label": "Avstånd ovanför", "default": "default", "options": [
      { "value": "default", "label": "Standard" }, { "value": "none", "label": "Inget" }, { "value": "s", "label": "Litet" },
      { "value": "m", "label": "Mellan" }, { "value": "l", "label": "Stort" }, { "value": "xl", "label": "Extra stort" }
    ] },
    { "type": "select", "id": "spacing_bottom", "label": "Avstånd under", "default": "default", "options": [
      { "value": "default", "label": "Standard" }, { "value": "none", "label": "Inget" }, { "value": "s", "label": "Litet" },
      { "value": "m", "label": "Mellan" }, { "value": "l", "label": "Stort" }, { "value": "xl", "label": "Extra stort" }
    ] }
  ]
}
{% endschema %}
