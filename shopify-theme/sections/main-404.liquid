<section class="section">
  <div class="page-width">
    <p class="eyebrow">404</p>
    <h1 class="mt-3 max-4xl">Sidan kunde inte hittas</h1>
    <p class="lede mt-4 max-xl">Sidan kan ha flyttats eller tagits bort. Gå tillbaka till startsidan eller kontakta oss, så hjälper vi dig vidare.</p>
    <div class="btn-row mt-5">
      <a href="{{ routes.root_url }}" class="btn btn--primary">Till startsidan {% render 'icon', name: 'arrow' %}</a>
      <a href="/pages/kontakt" class="btn btn--secondary">Kontakta oss {% render 'icon', name: 'arrow' %}</a>
    </div>
  </div>
</section>

{% schema %}
{ "name": "404", "tag": "div", "settings": [] }
{% endschema %}
