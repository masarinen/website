<section class="section--tight">
  <div class="page-width">
    <h1>Sök</h1>
    <form action="{{ routes.search_url }}" method="get" role="search" class="search-form">
      <label for="SearchInput" class="visually-hidden">Sök</label>
      <input id="SearchInput" type="search" name="q" value="{{ search.terms | escape }}" placeholder="Sök produkter och sidor">
      <button type="submit" class="btn btn--primary">Sök</button>
    </form>
    {%- if search.performed -%}
      {%- paginate search.results by 24 -%}
        <p class="muted mt-4" role="status">{{ search.results_count }} träffar för ”{{ search.terms | escape }}”</p>
        {%- if search.results_count > 0 -%}
          <ul class="products">
            {%- for item in search.results -%}
              <li>
                {%- if item.object_type == 'product' -%}{% render 'product-card', product: item %}
                {%- else -%}
                  <div class="product-card"><p class="product-card__vendor">Sida</p><h3 class="product-card__title"><a href="{{ item.url }}">{{ item.title }}</a></h3></div>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        {%- else -%}
          <div class="empty-state mt-4"><p>Inga träffar. Prova ett annat sökord.</p></div>
        {%- endif -%}
      {%- endpaginate -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{ "name": "Sökresultat", "tag": "div", "settings": [] }
{% endschema %}
