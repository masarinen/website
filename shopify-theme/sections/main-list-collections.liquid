<section class="section--tight">
  <div class="page-width">
    <p class="eyebrow">Webbutik</p>
    <h1 class="mt-2">Kategorier</h1>
    <ul class="cards">
      {%- for collection in collections -%}
        <li class="card">
          <div class="card__media">
            {%- if collection.featured_image -%}
              {{ collection.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw' }}
            {%- else -%}{% render 'illustration', name: 'suitcase' %}{%- endif -%}
          </div>
          <div class="card__body">
            <h2 class="card__title h3"><a href="{{ collection.url }}">{{ collection.title }}</a></h2>
            <p class="card__text">{{ collection.products_count }} produkter</p>
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{ "name": "Alla kollektioner", "tag": "div", "settings": [] }
{% endschema %}
