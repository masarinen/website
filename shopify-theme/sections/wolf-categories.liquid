<section class="section{% if section.settings.background == 'bone' %} bg-bone border-y{% endif %}" aria-labelledby="H-{{ section.id }}">
  <div class="page-width">
    <div class="section-head">
      <div class="max-2xl" data-reveal>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 id="H-{{ section.id }}" class="mt-2">{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.text != blank -%}<div class="lede mt-3 rte">{{ section.settings.text }}</div>{%- endif -%}
      </div>
      {%- if section.settings.link_label != blank -%}
        <p data-reveal><a class="arrow-link" href="{{ section.settings.link }}"><span class="link-underline">{{ section.settings.link_label }}</span>{% render 'icon', name: 'arrow' %}</a></p>
      {%- endif -%}
    </div>
    {%- if section.blocks.size > 0 -%}
    <ul class="cards">
      {%- for block in section.blocks -%}
        {%- assign c = block.settings -%}
        {%- assign link = c.link -%}
        {%- if c.collection != blank -%}{%- assign link = c.collection.url -%}{%- endif -%}
        <li class="card" {{ block.shopify_attributes }} data-reveal style="--d: {{ forloop.index0 | modulo: 3 | times: 90 }}ms">
          <div class="card__media">
            {%- if c.image != blank -%}
              {{ c.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw' }}
            {%- elsif c.collection.featured_image != blank -%}
              {{ c.collection.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw' }}
            {%- elsif c.illustration != 'none' -%}
              {% render 'illustration', name: c.illustration %}
            {%- endif -%}
          </div>
          <div class="card__body">
            <div class="card__top">
              <h3 class="card__title"><a href="{{ link }}">{{ c.title | default: c.collection.title }}</a></h3>
              {%- if c.tag != blank -%}<span class="card__tag">{{ c.tag }}</span>{%- endif -%}
            </div>
            {%- if c.text != blank -%}<p class="card__text">{{ c.text }}</p>{%- endif -%}
            {%- if c.brands != blank -%}<p class="card__brands"><span class="visually-hidden">Varumärken: </span>{{ c.brands }}</p>{%- endif -%}
            {%- if c.link_label != blank -%}<span class="card__more" aria-hidden="true"><span class="link-underline">{{ c.link_label }}</span><span>→</span></span>{%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>
    {%- else -%}
      <p class="empty-state mt-5">Lägg till kategorier i temaredigeraren.</p>
    {%- endif -%}
  </div>
</section>

