{% render 'section-style', s: section.settings, id: section.id %}
<section class="section wolf-sec{% if section.settings.background == 'bone' %} bg-bone border-y{% endif %}" aria-labelledby="H-{{ section.id }}">
  <div class="page-width">
    <div class="section-head">
      <div class="max-2xl" data-reveal>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 id="H-{{ section.id }}" class="mt-2">{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.text != blank -%}<div class="lede mt-3 rte">{{ section.settings.text }}</div>{%- endif -%}
      </div>
      {%- if section.settings.link_label != blank -%}
        <p data-reveal><a class="arrow-link" href="{{ section.settings.link }}"><span class="link-underline">{{ section.settings.link_label }}</span>{% render 'icon', name: 'arrow' %}</a></p>
      {%- endif -%}
    </div>
    {%- if section.blocks.size > 0 -%}
    <ul class="cards" style="--cols: {{ section.settings.columns }}">
      {%- for block in section.blocks -%}
        {%- assign c = block.settings -%}
        {%- assign link = c.link -%}
        {%- if c.collection != blank -%}{%- assign link = c.collection.url -%}{%- endif -%}
        <li class="card" {{ block.shopify_attributes }} data-reveal style="--d: {{ forloop.index0 | modulo: 3 | times: 90 }}ms">
          <div class="card__media">
            {%- if c.image != blank -%}
              {{ c.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw' }}
            {%- elsif c.collection.featured_image != blank -%}
              {{ c.collection.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw' }}
            {%- elsif c.illustration != 'none' -%}
              {% render 'illustration', name: c.illustration %}
            {%- endif -%}
          </div>
          <div class="card__body">
            <div class="card__top">
              <h3 class="card__title"><a href="{{ link }}">{{ c.title | default: c.collection.title }}</a></h3>
              {%- if c.tag != blank -%}<span class="card__tag">{{ c.tag }}</span>{%- endif -%}
            </div>
            {%- if c.text != blank -%}<p class="card__text">{{ c.text }}</p>{%- endif -%}
            {%- if c.brands != blank -%}<p class="card__brands"><span class="visually-hidden">Varumärken: </span>{{ c.brands }}</p>{%- endif -%}
            {%- if c.link_label != blank -%}<span class="card__more" aria-hidden="true"><span class="link-underline">{{ c.link_label }}</span><span>→</span></span>{%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>
    {%- else -%}
      <p class="empty-state mt-5">Lägg till kategorier i temaredigeraren.</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Kategorier",
  "tag": "div",
  "max_blocks": 18,
  "settings": [
    {"type": "text", "id": "eyebrow", "label": "Överrubrik", "default": "Våra lösningar"},
    {"type": "text", "id": "heading", "label": "Rubrik", "default": "Från demoväska till klockuppdragare"},
    {"type": "richtext", "id": "text", "label": "Ingress", "default": "<p>Ett urval av det vi arbetar med. Specialväskor tas fram efter era behov – övriga kategorier finns i webbutiken.</p>"},
    {"type": "text", "id": "link_label", "label": "Länktext uppe till höger", "default": "Hela sortimentet"},
    {"type": "url", "id": "link", "label": "Länk"},
    {"type": "select", "id": "background", "label": "Bakgrund", "default": "ivory", "options": [{"value": "ivory", "label": "Varmvit"}, {"value": "bone", "label": "Benvit"}]},
    {"type": "select", "id": "columns", "label": "Kolumner (dator)", "default": "3", "info": "En ofullständig sista rad centreras.", "options": [{"value": "2", "label": "2"}, {"value": "3", "label": "3"}, {"value": "4", "label": "4"}]},
    {"type": "header", "content": "Layout"},
    {"type": "select", "id": "spacing_top", "label": "Avstånd ovanför", "options": [{"value": "default", "label": "Standard"}, {"value": "none", "label": "Inget"}, {"value": "s", "label": "Litet"}, {"value": "m", "label": "Mellan"}, {"value": "l", "label": "Stort"}, {"value": "xl", "label": "Extra stort"}], "default": "default"},
    {"type": "select", "id": "spacing_bottom", "label": "Avstånd under", "options": [{"value": "default", "label": "Standard"}, {"value": "none", "label": "Inget"}, {"value": "s", "label": "Litet"}, {"value": "m", "label": "Mellan"}, {"value": "l", "label": "Stort"}, {"value": "xl", "label": "Extra stort"}], "default": "default"},
    {"type": "select", "id": "bg", "label": "Bakgrundsfärg", "default": "default", "options": [{"value": "default", "label": "Standard"}, {"value": "ivory", "label": "Varmvit"}, {"value": "bone", "label": "Benvit"}, {"value": "sand", "label": "Sand"}, {"value": "navy", "label": "Mörkblå"}]},
    {"type": "select", "id": "content_width", "label": "Innehållets bredd", "default": "default", "options": [{"value": "default", "label": "Standard"}, {"value": "narrow", "label": "Smal"}, {"value": "wide", "label": "Bred"}, {"value": "full", "label": "Hela skärmen"}]},
    {"type": "select", "id": "heading_size", "label": "Rubrikstorlek", "default": "default", "options": [{"value": "default", "label": "Standard"}, {"value": "s", "label": "Liten"}, {"value": "m", "label": "Mellan"}, {"value": "l", "label": "Stor"}, {"value": "xl", "label": "Extra stor"}]},
    {"type": "checkbox", "id": "hide_mobile", "label": "Dölj på mobil", "default": false},
    {"type": "checkbox", "id": "hide_desktop", "label": "Dölj på dator", "default": false}
  ],
  "blocks": [
    {"type": "category", "name": "Kategori", "settings": [{"type": "collection", "id": "collection", "label": "Kollektion (valfritt)", "info": "Välj en kollektion så används dess länk, och dess bild om ingen annan bild valts."}, {"type": "text", "id": "title", "label": "Rubrik", "default": "Kategori"}, {"type": "text", "id": "tag", "label": "Etikett", "default": "Webbutik"}, {"type": "textarea", "id": "text", "label": "Beskrivning"}, {"type": "text", "id": "brands", "label": "Varumärken"}, {"type": "image_picker", "id": "image", "label": "Bild"}, {"type": "select", "id": "illustration", "label": "Illustration (visas om ingen bild valts)", "options": [{"value": "hardcase", "label": "Hård väska med inredning"}, {"value": "demo", "label": "Demoväska"}, {"value": "suitcase", "label": "Resväska"}, {"value": "wine", "label": "Vinresväska"}, {"value": "toolcase", "label": "Serviceväska"}, {"value": "winder", "label": "Watch winder"}, {"value": "jewelry", "label": "Smyckeskrin"}, {"value": "briefcase", "label": "Portfölj"}, {"value": "trolley", "label": "Shoppingvagn"}, {"value": "none", "label": "Ingen"}], "default": "suitcase"}, {"type": "url", "id": "link", "label": "Länk (om ingen kollektion valts)"}, {"type": "text", "id": "link_label", "label": "Länktext", "default": "Se i webbutiken"}]}
  ],
  "presets": [
    {"name": "Kategorier", "blocks": [{"type": "category", "settings": {"title": "Specialväskor", "tag": "Specialtillverkning", "illustration": "hardcase", "text": "Väskor för nästan allt som går att bära – även vattentäta och stöttåliga utföranden, mjuka eller hårda efter behov.", "brands": "", "link": "/pages/specialtillverkade-vaskor", "link_label": "Läs mer"}}, {"type": "category", "settings": {"title": "Demoväskor", "tag": "Webbutik", "illustration": "demo", "text": "Kollektions-, försäljnings- och demoväskor för säljare. Vi har tillverkat dem i över 60 år, för allt från dammsugare till klockor och knivar.", "brands": "", "link": "/collections/all", "link_label": "Se i webbutiken"}}, {"type": "category", "settings": {"title": "Vinresväskor", "tag": "Webbutik", "illustration": "wine", "text": "Vinväska för tolv flaskor med skal i polypropylen, hjul, utdragbart handtag och kombinationslås.", "brands": "Samsonite", "link": "/collections/all", "link_label": "Se i webbutiken"}}, {"type": "category", "settings": {"title": "Serviceväskor", "tag": "Webbutik", "illustration": "toolcase", "text": "Ett brett urval av service- och verktygsväskor för tekniker och hantverkare.", "brands": "Parat", "link": "/collections/all", "link_label": "Se i webbutiken"}}, {"type": "category", "settings": {"title": "Watch winders", "tag": "Webbutik", "illustration": "winder", "text": "Klockuppdragare som håller automatiska armbandsur i gång när de inte bärs.", "brands": "Wolf1834", "link": "/collections/all", "link_label": "Se i webbutiken"}}, {"type": "category", "settings": {"title": "Smyckeskrin", "tag": "Webbutik", "illustration": "jewelry", "text": "Skrin som både presenterar och skyddar smycken – en tradition som går tillbaka till familjens första verkstad.", "brands": "Wolf1834", "link": "/collections/all", "link_label": "Se i webbutiken"}}]}
  ]
}
{% endschema %}
