{%- paginate blog.articles by 12 -%}
<section class="section--tight">
  <div class="page-width">
    <h1>{{ blog.title }}</h1>
    <ul class="cards">
      {%- for article in blog.articles -%}
        <li class="card">
          {%- if article.image -%}<div class="card__media">{{ article.image | image_url: width: 900 | image_tag: loading: 'lazy' }}</div>{%- endif -%}
          <div class="card__body">
            <p class="card__tag">{{ article.published_at | date: '%Y-%m-%d' }}</p>
            <h2 class="card__title h3 mt-1"><a href="{{ article.url }}">{{ article.title }}</a></h2>
            <p class="card__text">{{ article.excerpt_or_content | strip_html | truncatewords: 30 }}</p>
          </div>
        </li>
      {%- else -%}
        <li class="empty-state">Inga inlägg ännu.</li>
      {%- endfor -%}
    </ul>
  </div>
</section>
{%- endpaginate -%}

{% schema %}
{ "name": "Blogg", "tag": "div", "settings": [] }
{% endschema %}
