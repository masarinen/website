<section class="section">
  <div class="page-width" style="max-width: 36rem">
    {% render 'logo' %}
    <h1 class="mt-5">{{ shop.password_message | default: 'Webbplatsen öppnar snart' }}</h1>
    {%- form 'storefront_password', class: 'form mt-5' -%}
      {%- if form.errors -%}<p class="notice notice--error" role="alert">Fel lösenord. Försök igen.</p>{%- endif -%}
      <div class="field">
        <label for="Password">Lösenord</label>
        <input id="Password" type="password" name="password" autocomplete="current-password" required>
      </div>
      <button type="submit" class="btn btn--primary">Gå in</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{ "name": "Lösenordssida", "tag": "div", "settings": [] }
{% endschema %}
