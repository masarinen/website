# Publik bas-URL för webbplatsen (används för canonical-länkar, sitemap och Open Graph).
NEXT_PUBLIC_SITE_URL=https://www.wolf.se

# --- Kontaktformulär (valfritt) ---
# Formuläret skickar via Resend (https://resend.com). Utan dessa variabler är
# formuläret avaktiverat och besökaren hänvisas till e-post och telefon.
# Nycklarna läses endast på servern och exponeras aldrig i webbläsaren.
RESEND_API_KEY=
# Mottagare av förfrågningar
CONTACT_TO_EMAIL=robert@wolf.se
# Avsändare – måste vara en adress på en domän som är verifierad i Resend
CONTACT_FROM_EMAIL=Wolf webbplats <webb@wolf.se>
